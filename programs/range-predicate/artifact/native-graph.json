  "program_id": "range-predicate",
  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"range-predicate\",\n  \"title\": \"Range Predicate\",\n  \"purpose\": \"Decide inclusive interval membership, identify reversed bounds, and expose an editable upper-endpoint policy\",\n  \"parameters\": [\n    {\n      \"name\": \"value\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"lower\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"upper\",\n      \"value_type\": \"SInt64\"\n    }\n  ],\n  \"constants\": [\n    {\n      \"name\": \"yes\",\n      \"value_type\": \"Bool\",\n      \"value\": true\n    },\n    {\n      \"name\": \"no\",\n      \"value_type\": \"Bool\",\n      \"value\": false\n    },\n    {\n      \"name\": \"exclude_upper_endpoint\",\n      \"value_type\": \"Bool\",\n      \"value\": false\n    }\n  ],\n  \"result\": {\n    \"kind\": \"record\",\n    \"fields\": [\n      {\n        \"name\": \"within_range\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"invalid_bounds\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"below_lower\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"above_upper\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"excluded_upper\",\n        \"value_type\": \"Bool\"\n      }\n    ]\n  },\n  \"entry_block\": \"entry\",\n  \"blocks\": [\n    {\n      \"name\": \"entry\",\n      \"operations\": [\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"invalid\",\n          \"left\": \"param.lower\",\n          \"right\": \"param.upper\"\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"cond_branch\",\n        \"condition\": \"op.invalid\",\n        \"if_true\": \"invalid_bounds\",\n        \"if_false\": \"valid_bounds\"\n      }\n    },\n    {\n      \"name\": \"invalid_bounds\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"invalid_yes\",\n          \"constant\": \"yes\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"invalid_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"invalid_result\",\n          \"fields\": [\n            \"op.invalid_no\",\n            \"op.invalid_yes\",\n            \"op.invalid_no\",\n            \"op.invalid_no\",\n            \"op.invalid_no\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.invalid_result\"\n      }\n    },\n    {\n      \"name\": \"valid_bounds\",\n      \"operations\": [\n        {\n          \"op\": \"less_than\",\n          \"name\": \"below\",\n          \"left\": \"param.value\",\n          \"right\": \"param.lower\"\n        },\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"above\",\n          \"left\": \"param.value\",\n          \"right\": \"param.upper\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"under_upper\",\n          \"left\": \"param.value\",\n          \"right\": \"param.upper\"\n        },\n        {\n          \"op\": \"bool_not\",\n          \"name\": \"not_under_upper\",\n          \"operand\": \"op.under_upper\"\n        },\n        {\n          \"op\": \"bool_not\",\n          \"name\": \"not_above\",\n          \"operand\": \"op.above\"\n        },\n        {\n          \"op\": \"bool_and\",\n          \"name\": \"at_upper\",\n          \"left\": \"op.not_under_upper\",\n          \"right\": \"op.not_above\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"exclude_policy\",\n          \"constant\": \"exclude_upper_endpoint\"\n        },\n        {\n          \"op\": \"bool_and\",\n          \"name\": \"excluded_upper\",\n          \"left\": \"op.at_upper\",\n          \"right\": \"op.exclude_policy\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"strict_outside\",\n          \"left\": \"op.below\",\n          \"right\": \"op.above\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"outside\",\n          \"left\": \"op.strict_outside\",\n          \"right\": \"op.excluded_upper\"\n        },\n        {\n          \"op\": \"bool_not\",\n          \"name\": \"inside\",\n          \"operand\": \"op.outside\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"valid_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"valid_result\",\n          \"fields\": [\n            \"op.inside\",\n            \"op.valid_no\",\n            \"op.below\",\n            \"op.above\",\n            \"op.excluded_upper\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.valid_result\"\n      }\n    }\n  ]\n}\n",
