{
  "contract": "sley-tools.graph-authoring.v0",
  "program_id": "benchmark-selector",
  "title": "Benchmark Selector and Projector",
  "purpose": "Select matched rows with any regression and project candidate measurements using native logic",
  "parameters": [
    {
      "name": "baseline_wall_us",
      "value_type": "SInt64"
    },
    {
      "name": "candidate_wall_us",
      "value_type": "SInt64"
    },
    {
      "name": "baseline_cpu_us",
      "value_type": "SInt64"
    },
    {
      "name": "candidate_cpu_us",
      "value_type": "SInt64"
    },
    {
      "name": "baseline_archive_bytes",
      "value_type": "SInt64"
    },
    {
      "name": "candidate_archive_bytes",
      "value_type": "SInt64"
    }
  ],
  "constants": [
    {
      "name": "zero",
      "value_type": "SInt64",
      "value": "0"
    },
    {
      "name": "include_nonregressions",
      "value_type": "Bool",
      "value": false
    }
  ],
  "result": {
    "kind": "record",
    "fields": [
      {
        "name": "selected",
        "value_type": "Bool"
      },
      {
        "name": "candidate_wall_us",
        "value_type": "SInt64"
      },
      {
        "name": "candidate_cpu_us",
        "value_type": "SInt64"
      },
      {
        "name": "candidate_archive_bytes",
        "value_type": "SInt64"
      },
      {
        "name": "invalid_input",
        "value_type": "Bool"
      }
    ]
  },
  "entry_block": "entry",
  "blocks": [
    {
      "name": "entry",
      "operations": [
        {
          "op": "constant_ref",
          "name": "zero",
          "constant": "zero"
        },
        {
          "op": "constant_ref",
          "name": "include_nonregressions",
          "constant": "include_nonregressions"
        },
        {
          "op": "less_than",
          "name": "negative_baseline_wall_us",
          "left": "param.baseline_wall_us",
          "right": "op.zero"
        },
        {
          "op": "less_than",
          "name": "negative_candidate_wall_us",
          "left": "param.candidate_wall_us",
          "right": "op.zero"
        },
        {
          "op": "less_than",
          "name": "negative_baseline_cpu_us",
          "left": "param.baseline_cpu_us",
          "right": "op.zero"
        },
        {
          "op": "less_than",
          "name": "negative_candidate_cpu_us",
          "left": "param.candidate_cpu_us",
          "right": "op.zero"
        },
        {
          "op": "less_than",
          "name": "negative_baseline_archive_bytes",
          "left": "param.baseline_archive_bytes",
          "right": "op.zero"
        },
        {
          "op": "less_than",
          "name": "negative_candidate_archive_bytes",
          "left": "param.candidate_archive_bytes",
          "right": "op.zero"
        },
        {
          "op": "bool_or",
          "name": "negative_wall",
          "left": "op.negative_baseline_wall_us",
          "right": "op.negative_candidate_wall_us"
        },
        {
          "op": "bool_or",
          "name": "negative_cpu",
          "left": "op.negative_baseline_cpu_us",
          "right": "op.negative_candidate_cpu_us"
        },
        {
          "op": "bool_or",
          "name": "negative_archive",
          "left": "op.negative_baseline_archive_bytes",
          "right": "op.negative_candidate_archive_bytes"
        },
        {
          "op": "bool_or",
          "name": "negative_wall_cpu",
          "left": "op.negative_wall",
          "right": "op.negative_cpu"
        },
        {
          "op": "bool_or",
          "name": "invalid_input",
          "left": "op.negative_wall_cpu",
          "right": "op.negative_archive"
        },
        {
          "op": "greater_than",
          "name": "wall_regressed",
          "left": "param.candidate_wall_us",
          "right": "param.baseline_wall_us"
        },
        {
          "op": "greater_than",
          "name": "cpu_regressed",
          "left": "param.candidate_cpu_us",
          "right": "param.baseline_cpu_us"
        },
        {
          "op": "greater_than",
          "name": "archive_regressed",
          "left": "param.candidate_archive_bytes",
          "right": "param.baseline_archive_bytes"
        },
        {
          "op": "bool_or",
          "name": "wall_or_cpu",
          "left": "op.wall_regressed",
          "right": "op.cpu_regressed"
        },
        {
          "op": "bool_or",
          "name": "any_regression",
          "left": "op.wall_or_cpu",
          "right": "op.archive_regressed"
        },
        {
          "op": "bool_or",
          "name": "predicate",
          "left": "op.any_regression",
          "right": "op.include_nonregressions"
        },
        {
          "op": "bool_not",
          "name": "valid_input",
          "operand": "op.invalid_input"
        },
        {
          "op": "bool_and",
          "name": "selected",
          "left": "op.predicate",
          "right": "op.valid_input"
        },
        {
          "op": "record_new",
          "name": "result",
          "fields": [
            "op.selected",
            "param.candidate_wall_us",
            "param.candidate_cpu_us",
            "param.candidate_archive_bytes",
            "op.invalid_input"
          ]
        }
      ],
      "terminator": {
        "kind": "return",
        "value": "op.result"
      }
    }
  ]
}
