  "program_id": "benchmark-selector",
  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"benchmark-selector\",\n  \"title\": \"Benchmark Selector and Projector\",\n  \"purpose\": \"Select matched rows with any regression and project candidate measurements using native logic\",\n  \"parameters\": [\n    {\n      \"name\": \"baseline_wall_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"candidate_wall_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"baseline_cpu_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"candidate_cpu_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"baseline_archive_bytes\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"candidate_archive_bytes\",\n      \"value_type\": \"SInt64\"\n    }\n  ],\n  \"constants\": [\n    {\n      \"name\": \"zero\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"0\"\n    },\n    {\n      \"name\": \"include_nonregressions\",\n      \"value_type\": \"Bool\",\n      \"value\": false\n    }\n  ],\n  \"result\": {\n    \"kind\": \"record\",\n    \"fields\": [\n      {\n        \"name\": \"selected\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"candidate_wall_us\",\n        \"value_type\": \"SInt64\"\n      },\n      {\n        \"name\": \"candidate_cpu_us\",\n        \"value_type\": \"SInt64\"\n      },\n      {\n        \"name\": \"candidate_archive_bytes\",\n        \"value_type\": \"SInt64\"\n      },\n      {\n        \"name\": \"invalid_input\",\n        \"value_type\": \"Bool\"\n      }\n    ]\n  },\n  \"entry_block\": \"entry\",\n  \"blocks\": [\n    {\n      \"name\": \"entry\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"zero\",\n          \"constant\": \"zero\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"include_nonregressions\",\n          \"constant\": \"include_nonregressions\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_baseline_wall_us\",\n          \"left\": \"param.baseline_wall_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_candidate_wall_us\",\n          \"left\": \"param.candidate_wall_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_baseline_cpu_us\",\n          \"left\": \"param.baseline_cpu_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_candidate_cpu_us\",\n          \"left\": \"param.candidate_cpu_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_baseline_archive_bytes\",\n          \"left\": \"param.baseline_archive_bytes\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_candidate_archive_bytes\",\n          \"left\": \"param.candidate_archive_bytes\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"negative_wall\",\n          \"left\": \"op.negative_baseline_wall_us\",\n          \"right\": \"op.negative_candidate_wall_us\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"negative_cpu\",\n          \"left\": \"op.negative_baseline_cpu_us\",\n          \"right\": \"op.negative_candidate_cpu_us\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"negative_archive\",\n          \"left\": \"op.negative_baseline_archive_bytes\",\n          \"right\": \"op.negative_candidate_archive_bytes\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"negative_wall_cpu\",\n          \"left\": \"op.negative_wall\",\n          \"right\": \"op.negative_cpu\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"invalid_input\",\n          \"left\": \"op.negative_wall_cpu\",\n          \"right\": \"op.negative_archive\"\n        },\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"wall_regressed\",\n          \"left\": \"param.candidate_wall_us\",\n          \"right\": \"param.baseline_wall_us\"\n        },\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"cpu_regressed\",\n          \"left\": \"param.candidate_cpu_us\",\n          \"right\": \"param.baseline_cpu_us\"\n        },\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"archive_regressed\",\n          \"left\": \"param.candidate_archive_bytes\",\n          \"right\": \"param.baseline_archive_bytes\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"wall_or_cpu\",\n          \"left\": \"op.wall_regressed\",\n          \"right\": \"op.cpu_regressed\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"any_regression\",\n          \"left\": \"op.wall_or_cpu\",\n          \"right\": \"op.archive_regressed\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"predicate\",\n          \"left\": \"op.any_regression\",\n          \"right\": \"op.include_nonregressions\"\n        },\n        {\n          \"op\": \"bool_not\",\n          \"name\": \"valid_input\",\n          \"operand\": \"op.invalid_input\"\n        },\n        {\n          \"op\": \"bool_and\",\n          \"name\": \"selected\",\n          \"left\": \"op.predicate\",\n          \"right\": \"op.valid_input\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"result\",\n          \"fields\": [\n            \"op.selected\",\n            \"param.candidate_wall_us\",\n            \"param.candidate_cpu_us\",\n            \"param.candidate_archive_bytes\",\n            \"op.invalid_input\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.result\"\n      }\n    }\n  ]\n}\n",
