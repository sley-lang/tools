  "program_id": "bounded-clamp",
  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"bounded-clamp\",\n  \"title\": \"Bounded Clamp\",\n  \"purpose\": \"Clamp a signed value to configured inclusive bounds and reject reversed configuration\",\n  \"parameters\": [{\"name\": \"value\", \"value_type\": \"SInt64\"}],\n  \"constants\": [\n    {\"name\": \"lower_bound\", \"value_type\": \"SInt64\", \"value\": \"-5\"},\n    {\"name\": \"upper_bound\", \"value_type\": \"SInt64\", \"value\": \"5\"},\n    {\"name\": \"invalid_value\", \"value_type\": \"SInt64\", \"value\": \"0\"},\n    {\"name\": \"yes\", \"value_type\": \"Bool\", \"value\": true},\n    {\"name\": \"no\", \"value_type\": \"Bool\", \"value\": false}\n  ],\n  \"result\": {\"kind\": \"record\", \"fields\": [\n    {\"name\": \"clamped_value\", \"value_type\": \"SInt64\"},\n    {\"name\": \"invalid_bounds\", \"value_type\": \"Bool\"},\n    {\"name\": \"below_lower\", \"value_type\": \"Bool\"},\n    {\"name\": \"above_upper\", \"value_type\": \"Bool\"}\n  ]},\n  \"entry_block\": \"entry\",\n  \"blocks\": [\n    {\"name\": \"entry\", \"operations\": [\n      {\"op\": \"constant_ref\", \"name\": \"entry_lower\", \"constant\": \"lower_bound\"},\n      {\"op\": \"constant_ref\", \"name\": \"entry_upper\", \"constant\": \"upper_bound\"},\n      {\"op\": \"greater_than\", \"name\": \"bounds_reversed\", \"left\": \"op.entry_lower\", \"right\": \"op.entry_upper\"}\n    ], \"terminator\": {\"kind\": \"cond_branch\", \"condition\": \"op.bounds_reversed\", \"if_true\": \"invalid\", \"if_false\": \"compare_lower\"}},\n    {\"name\": \"invalid\", \"operations\": [\n      {\"op\": \"constant_ref\", \"name\": \"invalid_zero\", \"constant\": \"invalid_value\"},\n      {\"op\": \"constant_ref\", \"name\": \"invalid_yes\", \"constant\": \"yes\"},\n      {\"op\": \"constant_ref\", \"name\": \"invalid_no\", \"constant\": \"no\"},\n      {\"op\": \"record_new\", \"name\": \"invalid_result\", \"fields\": [\"op.invalid_zero\", \"op.invalid_yes\", \"op.invalid_no\", \"op.invalid_no\"]}\n    ], \"terminator\": {\"kind\": \"return\", \"value\": \"op.invalid_result\"}},\n    {\"name\": \"compare_lower\", \"operations\": [\n      {\"op\": \"constant_ref\", \"name\": \"check_lower\", \"constant\": \"lower_bound\"},\n      {\"op\": \"less_than\", \"name\": \"is_below\", \"left\": \"param.value\", \"right\": \"op.check_lower\"}\n    ], \"terminator\": {\"kind\": \"cond_branch\", \"condition\": \"op.is_below\", \"if_true\": \"below\", \"if_false\": \"compare_upper\"}},\n    {\"name\": \"below\", \"operations\": [\n      {\"op\": \"constant_ref\", \"name\": \"below_lower\", \"constant\": \"lower_bound\"},\n      {\"op\": \"constant_ref\", \"name\": \"below_yes\", \"constant\": \"yes\"},\n      {\"op\": \"constant_ref\", \"name\": \"below_no\", \"constant\": \"no\"},\n      {\"op\": \"record_new\", \"name\": \"below_result\", \"fields\": [\"op.below_lower\", \"op.below_no\", \"op.below_yes\", \"op.below_no\"]}\n    ], \"terminator\": {\"kind\": \"return\", \"value\": \"op.below_result\"}},\n    {\"name\": \"compare_upper\", \"operations\": [\n      {\"op\": \"constant_ref\", \"name\": \"check_upper\", \"constant\": \"upper_bound\"},\n      {\"op\": \"greater_than\", \"name\": \"is_above\", \"left\": \"param.value\", \"right\": \"op.check_upper\"}\n    ], \"terminator\": {\"kind\": \"cond_branch\", \"condition\": \"op.is_above\", \"if_true\": \"above\", \"if_false\": \"within\"}},\n    {\"name\": \"above\", \"operations\": [\n      {\"op\": \"constant_ref\", \"name\": \"above_upper\", \"constant\": \"upper_bound\"},\n      {\"op\": \"constant_ref\", \"name\": \"above_yes\", \"constant\": \"yes\"},\n      {\"op\": \"constant_ref\", \"name\": \"above_no\", \"constant\": \"no\"},\n      {\"op\": \"record_new\", \"name\": \"above_result\", \"fields\": [\"op.above_upper\", \"op.above_no\", \"op.above_no\", \"op.above_yes\"]}\n    ], \"terminator\": {\"kind\": \"return\", \"value\": \"op.above_result\"}},\n    {\"name\": \"within\", \"operations\": [\n      {\"op\": \"constant_ref\", \"name\": \"within_no\", \"constant\": \"no\"},\n      {\"op\": \"record_new\", \"name\": \"within_result\", \"fields\": [\"param.value\", \"op.within_no\", \"op.within_no\", \"op.within_no\"]}\n    ], \"terminator\": {\"kind\": \"return\", \"value\": \"op.within_result\"}}\n  ]\n}\n",
