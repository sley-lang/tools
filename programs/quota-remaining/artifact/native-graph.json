  "program_id": "quota-remaining",
  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"quota-remaining\",\n  \"title\": \"Quota Remaining\",\n  \"purpose\": \"Compute nonnegative remaining quota, report exhaustion, and expose an editable usage notification threshold\",\n  \"parameters\": [\n    {\n      \"name\": \"limit\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"used\",\n      \"value_type\": \"SInt64\"\n    }\n  ],\n  \"constants\": [\n    {\n      \"name\": \"zero\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"0\"\n    },\n    {\n      \"name\": \"notify_at_used\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"8\"\n    },\n    {\n      \"name\": \"yes\",\n      \"value_type\": \"Bool\",\n      \"value\": true\n    },\n    {\n      \"name\": \"no\",\n      \"value_type\": \"Bool\",\n      \"value\": false\n    }\n  ],\n  \"result\": {\n    \"kind\": \"record\",\n    \"fields\": [\n      {\n        \"name\": \"remaining\",\n        \"value_type\": \"CheckedSInt64\"\n      },\n      {\n        \"name\": \"exhausted\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"invalid_input\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"at_notification_level\",\n        \"value_type\": \"Bool\"\n      }\n    ]\n  },\n  \"entry_block\": \"entry\",\n  \"blocks\": [\n    {\n      \"name\": \"entry\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"entry_zero\",\n          \"constant\": \"zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_limit\",\n          \"left\": \"param.limit\",\n          \"right\": \"op.entry_zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_used\",\n          \"left\": \"param.used\",\n          \"right\": \"op.entry_zero\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"any_negative\",\n          \"left\": \"op.negative_limit\",\n          \"right\": \"op.negative_used\"\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"cond_branch\",\n        \"condition\": \"op.any_negative\",\n        \"if_true\": \"invalid\",\n        \"if_false\": \"check_exhaustion\"\n      }\n    },\n    {\n      \"name\": \"invalid\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"invalid_zero\",\n          \"constant\": \"zero\"\n        },\n        {\n          \"op\": \"result_ok\",\n          \"name\": \"invalid_remaining\",\n          \"operand\": \"op.invalid_zero\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"invalid_yes\",\n          \"constant\": \"yes\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"invalid_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"invalid_result\",\n          \"fields\": [\n            \"op.invalid_remaining\",\n            \"op.invalid_no\",\n            \"op.invalid_yes\",\n            \"op.invalid_no\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.invalid_result\"\n      }\n    },\n    {\n      \"name\": \"check_exhaustion\",\n      \"operations\": [\n        {\n          \"op\": \"greater_equal\",\n          \"name\": \"is_exhausted\",\n          \"left\": \"param.used\",\n          \"right\": \"param.limit\"\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"cond_branch\",\n        \"condition\": \"op.is_exhausted\",\n        \"if_true\": \"exhausted\",\n        \"if_false\": \"remaining\"\n      }\n    },\n    {\n      \"name\": \"exhausted\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"exhausted_zero\",\n          \"constant\": \"zero\"\n        },\n        {\n          \"op\": \"result_ok\",\n          \"name\": \"exhausted_remaining\",\n          \"operand\": \"op.exhausted_zero\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"exhausted_yes\",\n          \"constant\": \"yes\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"exhausted_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"exhausted_notify_level\",\n          \"constant\": \"notify_at_used\"\n        },\n        {\n          \"op\": \"greater_equal\",\n          \"name\": \"exhausted_notify\",\n          \"left\": \"param.used\",\n          \"right\": \"op.exhausted_notify_level\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"exhausted_result\",\n          \"fields\": [\n            \"op.exhausted_remaining\",\n            \"op.exhausted_yes\",\n            \"op.exhausted_no\",\n            \"op.exhausted_notify\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.exhausted_result\"\n      }\n    },\n    {\n      \"name\": \"remaining\",\n      \"operations\": [\n        {\n          \"op\": \"int_sub_checked\",\n          \"name\": \"remaining_amount\",\n          \"left\": \"param.limit\",\n          \"right\": \"param.used\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"remaining_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"remaining_notify_level\",\n          \"constant\": \"notify_at_used\"\n        },\n        {\n          \"op\": \"greater_equal\",\n          \"name\": \"remaining_notify\",\n          \"left\": \"param.used\",\n          \"right\": \"op.remaining_notify_level\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"remaining_result\",\n          \"fields\": [\n            \"op.remaining_amount\",\n            \"op.remaining_no\",\n            \"op.remaining_no\",\n            \"op.remaining_notify\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.remaining_result\"\n      }\n    }\n  ]\n}\n",
