  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"benchmark-comparator\",\n  \"title\": \"Benchmark Comparator\",\n  \"purpose\": \"Compare one matched benchmark row with exact native deltas and independent regression flags\",\n  \"parameters\": [\n    {\n      \"name\": \"baseline_wall_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"candidate_wall_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"baseline_cpu_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"candidate_cpu_us\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"baseline_archive_bytes\",\n      \"value_type\": \"SInt64\"\n    },\n    {\n      \"name\": \"candidate_archive_bytes\",\n      \"value_type\": \"SInt64\"\n    }\n  ],\n  \"constants\": [\n    {\n      \"name\": \"zero\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"0\"\n    },\n    {\n      \"name\": \"reject_negative_inputs\",\n      \"value_type\": \"Bool\",\n      \"value\": true\n    }\n  ],\n  \"result\": {\n    \"kind\": \"record\",\n    \"fields\": [\n      {\n        \"name\": \"wall_delta_us\",\n        \"value_type\": \"CheckedSInt64\"\n      },\n      {\n        \"name\": \"cpu_delta_us\",\n        \"value_type\": \"CheckedSInt64\"\n      },\n      {\n        \"name\": \"archive_delta_bytes\",\n        \"value_type\": \"CheckedSInt64\"\n      },\n      {\n        \"name\": \"wall_regressed\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"cpu_regressed\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"archive_regressed\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"any_regression\",\n        \"value_type\": \"Bool\"\n      },\n      {\n        \"name\": \"invalid_input\",\n        \"value_type\": \"Bool\"\n      }\n    ]\n  },\n  \"entry_block\": \"entry\",\n  \"blocks\": [\n    {\n      \"name\": \"entry\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"zero\",\n          \"constant\": \"zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_wall_base\",\n          \"left\": \"param.baseline_wall_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_wall_candidate\",\n          \"left\": \"param.candidate_wall_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_cpu_base\",\n          \"left\": \"param.baseline_cpu_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_cpu_candidate\",\n          \"left\": \"param.candidate_cpu_us\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_archive_base\",\n          \"left\": \"param.baseline_archive_bytes\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"negative_archive_candidate\",\n          \"left\": \"param.candidate_archive_bytes\",\n          \"right\": \"op.zero\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"invalid_wall\",\n          \"left\": \"op.negative_wall_base\",\n          \"right\": \"op.negative_wall_candidate\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"invalid_cpu\",\n          \"left\": \"op.negative_cpu_base\",\n          \"right\": \"op.negative_cpu_candidate\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"invalid_archive\",\n          \"left\": \"op.negative_archive_base\",\n          \"right\": \"op.negative_archive_candidate\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"invalid_wall_cpu\",\n          \"left\": \"op.invalid_wall\",\n          \"right\": \"op.invalid_cpu\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"negative_any\",\n          \"left\": \"op.invalid_wall_cpu\",\n          \"right\": \"op.invalid_archive\"\n        },\n        {\n          \"op\": \"int_sub_checked\",\n          \"name\": \"wall_delta\",\n          \"left\": \"param.candidate_wall_us\",\n          \"right\": \"param.baseline_wall_us\"\n        },\n        {\n          \"op\": \"int_sub_checked\",\n          \"name\": \"cpu_delta\",\n          \"left\": \"param.candidate_cpu_us\",\n          \"right\": \"param.baseline_cpu_us\"\n        },\n        {\n          \"op\": \"int_sub_checked\",\n          \"name\": \"archive_delta\",\n          \"left\": \"param.candidate_archive_bytes\",\n          \"right\": \"param.baseline_archive_bytes\"\n        },\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"wall_regressed\",\n          \"left\": \"param.candidate_wall_us\",\n          \"right\": \"param.baseline_wall_us\"\n        },\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"cpu_regressed\",\n          \"left\": \"param.candidate_cpu_us\",\n          \"right\": \"param.baseline_cpu_us\"\n        },\n        {\n          \"op\": \"greater_than\",\n          \"name\": \"archive_regressed\",\n          \"left\": \"param.candidate_archive_bytes\",\n          \"right\": \"param.baseline_archive_bytes\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"wall_or_cpu\",\n          \"left\": \"op.wall_regressed\",\n          \"right\": \"op.cpu_regressed\"\n        },\n        {\n          \"op\": \"bool_or\",\n          \"name\": \"any_regression\",\n          \"left\": \"op.wall_or_cpu\",\n          \"right\": \"op.archive_regressed\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"reject_negatives\",\n          \"constant\": \"reject_negative_inputs\"\n        },\n        {\n          \"op\": \"bool_and\",\n          \"name\": \"invalid_input\",\n          \"left\": \"op.negative_any\",\n          \"right\": \"op.reject_negatives\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"result\",\n          \"fields\": [\n            \"op.wall_delta\",\n            \"op.cpu_delta\",\n            \"op.archive_delta\",\n            \"op.wall_regressed\",\n            \"op.cpu_regressed\",\n            \"op.archive_regressed\",\n            \"op.any_regression\",\n            \"op.invalid_input\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.result\"\n      }\n    }\n  ]\n}\n",
