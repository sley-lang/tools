  "program_id": "tier-classifier",
  "recipe_json": "{\n  \"contract\": \"sley-tools.graph-authoring.v0\",\n  \"program_id\": \"tier-classifier\",\n  \"title\": \"Tier Classifier\",\n  \"purpose\": \"Classify any signed value into bronze, silver, or gold with ordered editable thresholds and an explicit invalid-configuration result\",\n  \"parameters\": [\n    {\n      \"name\": \"value\",\n      \"value_type\": \"SInt64\"\n    }\n  ],\n  \"constants\": [\n    {\n      \"name\": \"bronze_max\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"10\"\n    },\n    {\n      \"name\": \"silver_max\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"20\"\n    },\n    {\n      \"name\": \"middle_tier_enabled\",\n      \"value_type\": \"Bool\",\n      \"value\": true\n    },\n    {\n      \"name\": \"invalid_tier\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"-1\"\n    },\n    {\n      \"name\": \"bronze_tier\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"0\"\n    },\n    {\n      \"name\": \"silver_tier\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"1\"\n    },\n    {\n      \"name\": \"gold_tier\",\n      \"value_type\": \"SInt64\",\n      \"value\": \"2\"\n    },\n    {\n      \"name\": \"yes\",\n      \"value_type\": \"Bool\",\n      \"value\": true\n    },\n    {\n      \"name\": \"no\",\n      \"value_type\": \"Bool\",\n      \"value\": false\n    }\n  ],\n  \"result\": {\n    \"kind\": \"record\",\n    \"fields\": [\n      {\n        \"name\": \"tier\",\n        \"value_type\": \"SInt64\"\n      },\n      {\n        \"name\": \"invalid_configuration\",\n        \"value_type\": \"Bool\"\n      }\n    ]\n  },\n  \"entry_block\": \"entry\",\n  \"blocks\": [\n    {\n      \"name\": \"entry\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"entry_bronze_limit\",\n          \"constant\": \"bronze_max\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"entry_silver_limit\",\n          \"constant\": \"silver_max\"\n        },\n        {\n          \"op\": \"less_than\",\n          \"name\": \"ordered\",\n          \"left\": \"op.entry_bronze_limit\",\n          \"right\": \"op.entry_silver_limit\"\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"cond_branch\",\n        \"condition\": \"op.ordered\",\n        \"if_true\": \"bronze_check\",\n        \"if_false\": \"invalid_config\"\n      }\n    },\n    {\n      \"name\": \"invalid_config\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"invalid_value\",\n          \"constant\": \"invalid_tier\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"invalid_yes\",\n          \"constant\": \"yes\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"invalid_result\",\n          \"fields\": [\n            \"op.invalid_value\",\n            \"op.invalid_yes\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.invalid_result\"\n      }\n    },\n    {\n      \"name\": \"bronze_check\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"check_bronze_limit\",\n          \"constant\": \"bronze_max\"\n        },\n        {\n          \"op\": \"less_equal\",\n          \"name\": \"in_bronze\",\n          \"left\": \"param.value\",\n          \"right\": \"op.check_bronze_limit\"\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"cond_branch\",\n        \"condition\": \"op.in_bronze\",\n        \"if_true\": \"bronze_return\",\n        \"if_false\": \"silver_check\"\n      }\n    },\n    {\n      \"name\": \"bronze_return\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"bronze_value\",\n          \"constant\": \"bronze_tier\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"bronze_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"bronze_result\",\n          \"fields\": [\n            \"op.bronze_value\",\n            \"op.bronze_no\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.bronze_result\"\n      }\n    },\n    {\n      \"name\": \"silver_check\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"check_silver_limit\",\n          \"constant\": \"silver_max\"\n        },\n        {\n          \"op\": \"less_equal\",\n          \"name\": \"in_silver\",\n          \"left\": \"param.value\",\n          \"right\": \"op.check_silver_limit\"\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"cond_branch\",\n        \"condition\": \"op.in_silver\",\n        \"if_true\": \"middle_policy\",\n        \"if_false\": \"gold_return\"\n      }\n    },\n    {\n      \"name\": \"middle_policy\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"middle_enabled\",\n          \"constant\": \"middle_tier_enabled\"\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"cond_branch\",\n        \"condition\": \"op.middle_enabled\",\n        \"if_true\": \"silver_return\",\n        \"if_false\": \"gold_return\"\n      }\n    },\n    {\n      \"name\": \"silver_return\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"silver_value\",\n          \"constant\": \"silver_tier\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"silver_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"silver_result\",\n          \"fields\": [\n            \"op.silver_value\",\n            \"op.silver_no\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.silver_result\"\n      }\n    },\n    {\n      \"name\": \"gold_return\",\n      \"operations\": [\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"gold_value\",\n          \"constant\": \"gold_tier\"\n        },\n        {\n          \"op\": \"constant_ref\",\n          \"name\": \"gold_no\",\n          \"constant\": \"no\"\n        },\n        {\n          \"op\": \"record_new\",\n          \"name\": \"gold_result\",\n          \"fields\": [\n            \"op.gold_value\",\n            \"op.gold_no\"\n          ]\n        }\n      ],\n      \"terminator\": {\n        \"kind\": \"return\",\n        \"value\": \"op.gold_result\"\n      }\n    }\n  ]\n}\n",
