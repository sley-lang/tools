  "cases_json": "{\n  \"contract\": \"sley-tools.graph-cases.v0\",\n  \"cases\": [\n    {\n      \"id\": \"lower-endpoint\",\n      \"input\": [\n        \"-5\",\n        \"-5\",\n        \"5\"\n      ],\n      \"expected\": {\n        \"within_range\": true,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"interior\",\n      \"input\": [\n        \"0\",\n        \"-5\",\n        \"5\"\n      ],\n      \"expected\": {\n        \"within_range\": true,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"upper-endpoint\",\n      \"input\": [\n        \"5\",\n        \"-5\",\n        \"5\"\n      ],\n      \"expected\": {\n        \"within_range\": true,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"below\",\n      \"input\": [\n        \"-6\",\n        \"-5\",\n        \"5\"\n      ],\n      \"expected\": {\n        \"within_range\": false,\n        \"invalid_bounds\": false,\n        \"below_lower\": true,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"above\",\n      \"input\": [\n        \"6\",\n        \"-5\",\n        \"5\"\n      ],\n      \"expected\": {\n        \"within_range\": false,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": true,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"reversed-bounds\",\n      \"input\": [\n        \"0\",\n        \"5\",\n        \"-5\"\n      ],\n      \"expected\": {\n        \"within_range\": false,\n        \"invalid_bounds\": true,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"minimum-signed\",\n      \"input\": [\n        \"-9223372036854775808\",\n        \"-9223372036854775808\",\n        \"9223372036854775807\"\n      ],\n      \"expected\": {\n        \"within_range\": true,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"maximum-signed\",\n      \"input\": [\n        \"9223372036854775807\",\n        \"-9223372036854775808\",\n        \"9223372036854775807\"\n      ],\n      \"expected\": {\n        \"within_range\": true,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"singleton-hit\",\n      \"input\": [\n        \"7\",\n        \"7\",\n        \"7\"\n      ],\n      \"expected\": {\n        \"within_range\": true,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"singleton-miss\",\n      \"input\": [\n        \"8\",\n        \"7\",\n        \"7\"\n      ],\n      \"expected\": {\n        \"within_range\": false,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": true,\n        \"excluded_upper\": false\n      }\n    },\n    {\n      \"id\": \"negative-upper-endpoint\",\n      \"input\": [\n        \"-1\",\n        \"-9\",\n        \"-1\"\n      ],\n      \"expected\": {\n        \"within_range\": true,\n        \"invalid_bounds\": false,\n        \"below_lower\": false,\n        \"above_upper\": false,\n        \"excluded_upper\": false\n      }\n    }\n  ]\n}\n",
